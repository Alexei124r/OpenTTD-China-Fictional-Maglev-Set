}

switch (FEAT_TRAINS, SELF, sw_tr2015_head_direction, sw_head_is_front()) {
    1: sw_tr2015_head_livery_graphics;
    sw_tr2015_head_tail_graphics;
}

switch (FEAT_TRAINS, SELF, sw_tr2015_head_graphics,
    position_in_articulated_veh % 3) {
    1: sw_tr2015_head_direction;
    empty_sprites;
}

// The red dragon mid car reuses the TR08 white/red sheet. Only silver sword
// has a TR2015-specific intermediate-car sheet.
switch (FEAT_TRAINS, PARENT, sw_parent_tr2015_mid_livery, cargo_subtype) {
