// ----------------------------------------------------------------------------
// Shared callbacks
// ----------------------------------------------------------------------------

// 2 + 8 + 2 = 12 units = 0.75 tile.  Never exceed 8 units per part.
switch (FEAT_TRAINS, SELF, sw_length_2_8_2, position_in_articulated_veh % 3) {
    1: return 8;
    return 2;
}

// PARENT resolves to the first vehicle of the train. Counting from there
// gives a whole-consist result and avoids SELF's forward-only count_veh_id().
switch (FEAT_TRAINS, PARENT, sw_parent_regular_head_parts,
    count_veh_id(100) + count_veh_id(101) + count_veh_id(102) +
    count_veh_id(106) + count_veh_id(107)) {
    return;
}

switch (FEAT_TRAINS, PARENT, sw_parent_mr2015_parts,
    count_veh_id(105)) {
    return;
}

// True when the existing consist contains at least one non-MR2015 vehicle.
switch (FEAT_TRAINS, PARENT, sw_parent_has_regular_vehicle,
    num_vehs_in_consist > count_veh_id(105)) {
    1: return 1;
    return 0;
}

// 单头沿用原位置判断；双头时比较两者在整列中的相对位置。
switch (FEAT_TRAINS, SELF, sw_single_head_at_end,
    position_in_consist < 3) {
    1: return 1;
    return 0;
}

switch (FEAT_TRAINS, SELF, sw_single_head_is_front,
    position_in_consist_from_end < 3) {
    1: sw_single_head_at_end;
    return 1;
}

switch (FEAT_TRAINS, SELF, sw_head_is_front,
    sw_parent_regular_head_parts()) {
    3: sw_single_head_is_front;
    6: return position_in_consist < position_in_consist_from_end;
    return 1;
}

switch (FEAT_TRAINS, SELF, sw_std_head_start_stop,
    (sw_parent_regular_head_parts() <= 6) &&
    (sw_parent_regular_head_parts() == 3 ||
     sw_parent_regular_head_parts() == 6) &&
    !((num_vehs_in_consist > sw_parent_mr2015_parts()) &&
      (sw_parent_mr2015_parts() > 6)) &&
    !((sw_parent_regular_head_parts() == 6) &&
      (num_vehs_in_consist - sw_parent_regular_head_parts() -
       sw_parent_mr2015_parts() < 3))) {
    1: return CB_RESULT_NO_TEXT;
    return string(STR_ERROR_CONSIST);
}

// Mixed MR consists must put every engineering car at an outer end.
switch (FEAT_TRAINS, SELF, sw_mr2015_start_stop,
    (num_vehs_in_consist <= sw_parent_mr2015_parts()) ||
    ((sw_parent_mr2015_parts() <= 6) &&
     (position_in_consist < 3 || position_in_consist_from_end < 3))) {
    1: return CB_RESULT_NO_TEXT;
    return string(STR_ERROR_CONSIST);
}

switch (FEAT_TRAINS, SELF, sw_mail_capacity_scale, param_mail_capacity_mode) {
    0: return 50;
    1: return 100;
    2: return 200;
    return 400;
}

switch (FEAT_TRAINS, SELF, sw_loading_scale, param_loading_mode) {
    0: return 1;
    1: return 2;
    return 4;
}

switch (FEAT_TRAINS, SELF, sw_cargo_age_scale, param_cargo_age_mode) {
    0: return 1;
    1: return 2;
    return 4;
}

// Power callbacks are given in HP (the unit of the power callback).
// Only articulated part 0 is powered, the other two parts report 0 so the
// power of an item is not counted three times.
//   3600 kW = 4829 hp
//   3000 kW = 4023 hp
//   2400 kW = 3218 hp
//   2000 kW = 2682 hp
//   6400 kW = 8582 hp
//   4800 kW = 6437 hp
switch (FEAT_TRAINS, SELF, sw_power_head_tr08_base, position_in_articulated_veh % 3) {
    0: return 4829;
    return 0;
}

switch (FEAT_TRAINS, SELF, sw_power_head_tr2012_base, position_in_articulated_veh % 3) {
    0: return 4023;
    return 0;
}

switch (FEAT_TRAINS, SELF, sw_power_mid_tr08_base, position_in_articulated_veh % 3) {
    0: return 3218;
    return 0;
}

switch (FEAT_TRAINS, SELF, sw_power_mid_tr2012_base, position_in_articulated_veh % 3) {
    0: return 2682;
    return 0;
}

switch (FEAT_TRAINS, SELF, sw_power_freight_head_base, position_in_articulated_veh % 3) {
    0: return 6437;
    return 0;
}

switch (FEAT_TRAINS, SELF, sw_power_freight_mid_base, position_in_articulated_veh % 3) {
    0: return 6437;
    return 0;
}

// MR2015 presence is checked from the front of the whole consist.
switch (FEAT_TRAINS, SELF, sw_mr2015_present,
    sw_parent_mr2015_parts() > 0) {
    1: return 1;
    return 0;
}

switch (FEAT_TRAINS, SELF, sw_power_head_tr08, sw_mr2015_present()) {
    1: return 0;
    sw_power_head_tr08_base;
}

switch (FEAT_TRAINS, SELF, sw_power_head_tr2012, sw_mr2015_present()) {
    1: return 0;
    sw_power_head_tr2012_base;
}

switch (FEAT_TRAINS, SELF, sw_power_mid_tr08, sw_mr2015_present()) {
    1: return 0;
    sw_power_mid_tr08_base;
}

switch (FEAT_TRAINS, SELF, sw_power_mid_tr2012, sw_mr2015_present()) {
    1: return 0;
    sw_power_mid_tr2012_base;
}

switch (FEAT_TRAINS, SELF, sw_power_tr2015_freight_head, sw_mr2015_present()) {
    1: return 0;
    sw_power_freight_head_base;
}

switch (FEAT_TRAINS, SELF, sw_power_tr2015_freight_mid, sw_mr2015_present()) {
    1: return 0;
    sw_power_freight_mid_base;
}

switch (FEAT_TRAINS, SELF, sw_traction_head_tr08_base,
    position_in_articulated_veh % 3) {
    0: return 89;
    return 0;
}

switch (FEAT_TRAINS, SELF, sw_traction_head_tr2012_base,
    position_in_articulated_veh % 3) {
    0: return 82;
    return 0;
}

switch (FEAT_TRAINS, SELF, sw_traction_tr2015_head_base,
    position_in_articulated_veh % 3) {
    0: return 89;
    return 0;
}

switch (FEAT_TRAINS, SELF, sw_traction_head_tr08, sw_mr2015_present()) {
    1: return 0;
    sw_traction_head_tr08_base;
}

switch (FEAT_TRAINS, SELF, sw_traction_head_tr2012, sw_mr2015_present()) {
    1: return 0;
    sw_traction_head_tr2012_base;
}

switch (FEAT_TRAINS, SELF, sw_traction_tr2015_head, sw_mr2015_present()) {
    1: return 0;
    sw_traction_tr2015_head_base;
}

switch (FEAT_TRAINS, SELF, sw_traction_mid_tr08, sw_mr2015_present()) {
    1: return 0;
    return 89;
}

switch (FEAT_TRAINS, SELF, sw_traction_mid_tr2012, sw_mr2015_present()) {
    1: return 0;
    return 82;
}

switch (FEAT_TRAINS, SELF, sw_traction_tr2015_mid, sw_mr2015_present()) {
    1: return 0;
    return 89;
}

switch (FEAT_TRAINS, SELF, sw_traction_freight, sw_mr2015_present()) {
    1: return 0;
    return 89;
}

switch (FEAT_TRAINS, SELF, sw_power_mr2015, position_in_articulated_veh % 3) {
    0: return 8582;
    return 0;
}

// MR2015 runs at 160 km/h alone or with other MR2015s. A mixed consist is
// limited to 100 km/h by this single vehicle; OpenTTD uses the slowest unit.
switch (FEAT_TRAINS, SELF, sw_speed_mr2015,
    num_vehs_in_consist > sw_parent_mr2015_parts()) {
    1: return 100;
    return 160;
}

switch (FEAT_TRAINS, SELF, sw_cap_mr2015, position_in_articulated_veh % 3) {
    1: return (8 * param_capacity) / 100;
    return 0;
}

// TR2015 passenger head. The head itself is first-class only; refits select
// the livery. The class of the train is determined by the intermediate cars
// attached behind it.
switch (FEAT_TRAINS, SELF, sw_tr2015_head_subtype_text, cargo_subtype) {
    0: return string(STR_SUB_T15_RED_DRAGON_S);
    1: return string(STR_SUB_T15_SILVER_SWORD_S);
    2: return string(STR_SUB_T15_SHANGHAI_METRO_S);
    return CB_RESULT_NO_TEXT;
}

switch (FEAT_TRAINS, SELF, sw_tr2015_head_livery_graphics, cargo_subtype) {
    0: sp_t15_head_red_dragon;
    1: sp_t15_head_silver_sword;
    2: sp_t15_head_shanghai_metro;
    sp_t15_head_red_dragon;
}

switch (FEAT_TRAINS, SELF, sw_tr2015_head_tail_graphics, cargo_subtype) {
