// Passenger TR2015: first-class head, 12 passengers.
switch (FEAT_TRAINS, SELF, sw_power_tr2015_head_base,
    position_in_articulated_veh % 3) {
    0: return 4829;
    return 0;
}

switch (FEAT_TRAINS, SELF, sw_power_tr2015_head, sw_mr2015_present()) {
