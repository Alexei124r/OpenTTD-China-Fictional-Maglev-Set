    position_in_articulated_veh % 3) {
    1: return 15 * sw_loading_scale();
    return 0;
}

switch (FEAT_TRAINS, SELF, sw_age_tr2015_zexl_passenger,
    position_in_articulated_veh % 3) {
    1: return 250 * sw_cargo_age_scale();
    return 0;
}

// MR2015 graphics automatically swap to the reversed sprite at the rear.
switch (FEAT_TRAINS, SELF, sw_eng_mr2015_front_position,
    position_in_articulated_veh % 3) {
    1: sp_eng_mr2015;
    empty_sprites;
}

switch (FEAT_TRAINS, SELF, sw_eng_mr2015_rear_position,
    position_in_articulated_veh % 3) {
    1: sp_eng_mr2015_tail;
    empty_sprites;
}

switch (FEAT_TRAINS, SELF, sw_eng_mr2015_alone_check,
    position_in_consist < 3) {
    1: sw_eng_mr2015_front_position;
    sw_eng_mr2015_rear_position;
}

switch (FEAT_TRAINS, SELF, sw_eng_mr2015_graphics,
    position_in_consist_from_end < 3) {
    1: sw_eng_mr2015_alone_check;
    sw_eng_mr2015_front_position;
}

switch (FEAT_TRAINS, SELF, sw_mr2015_articulated, extra_callback_info1) {
    1..2: return maglevranger_2015;
    return CB_RESULT_NO_MORE_ARTICULATED_PARTS;
}

switch (FEAT_TRAINS, SELF, sw_tr2015_articulated, extra_callback_info1) {
    1..2: return tr2015_head;
    return CB_RESULT_NO_MORE_ARTICULATED_PARTS;
}

switch (FEAT_TRAINS, SELF, sw_tr2015_freight_head_articulated,
    extra_callback_info1) {
    1..2: return tr2015_freight_head;
    return CB_RESULT_NO_MORE_ARTICULATED_PARTS;
}

switch (FEAT_TRAINS, SELF, sw_tr2015_freight_mid_articulated,
    extra_callback_info1) {
    1..2: return tr2015_freight_mid;
    return CB_RESULT_NO_MORE_ARTICULATED_PARTS;
}

switch (FEAT_TRAINS, SELF, sw_tr2015_refrigerated_articulated,
    extra_callback_info1) {
    1..2: return tr2015_refrigerated;
    return CB_RESULT_NO_MORE_ARTICULATED_PARTS;
}

switch (FEAT_TRAINS, SELF, sw_tr2015_zexl_articulated,
    extra_callback_info1) {
    1..2: return tr2015_zexl_passenger;
    return CB_RESULT_NO_MORE_ARTICULATED_PARTS;
}

// Head car capacity (only the middle part carries the passenger compartment)
switch (FEAT_TRAINS, SELF, sw_cap_tr08_head_first, position_in_articulated_veh % 3) {
    1: return (60 * param_capacity) / 100;
    return 0;
}
switch (FEAT_TRAINS, SELF, sw_cap_tr08_head_second, position_in_articulated_veh % 3) {
    1: return (90 * param_capacity) / 100;
    return 0;
}
switch (FEAT_TRAINS, SELF, sw_cap_tr2012_head, position_in_articulated_veh % 3) {
    1: return (150 * param_capacity) / 100;
    return 0;
}

switch (FEAT_TRAINS, SELF, sw_age_tr08_head_first, position_in_articulated_veh % 3) {
    1: return 400 * sw_cargo_age_scale();
    return 0;
}
switch (FEAT_TRAINS, SELF, sw_age_tr08_head_second, position_in_articulated_veh % 3) {
    1: return 250 * sw_cargo_age_scale();
    return 0;
}
switch (FEAT_TRAINS, SELF, sw_age_tr2012_head, position_in_articulated_veh % 3) {
    1: return 200 * sw_cargo_age_scale();
    return 0;
}

// Intermediate car capacity / age, used from the livery_override blocks.
// mid_first is only allowed behind TR08 heads.
switch (FEAT_TRAINS, SELF, sw_cap_mid_first, position_in_articulated_veh % 3) {
    1: return (80 * param_capacity) / 100;
    return 0;
}
switch (FEAT_TRAINS, SELF, sw_cap_mid_second_tr08, position_in_articulated_veh % 3) {
    1: return (120 * param_capacity) / 100;
    return 0;
}
switch (FEAT_TRAINS, SELF, sw_cap_mid_second_tr2012, position_in_articulated_veh % 3) {
    1: return (200 * param_capacity) / 100;
    return 0;
}

switch (FEAT_TRAINS, SELF, sw_age_mid_first, position_in_articulated_veh % 3) {
    1: return 400 * sw_cargo_age_scale();
    return 0;
}
switch (FEAT_TRAINS, SELF, sw_age_mid_second_tr08, position_in_articulated_veh % 3) {
    1: return 250 * sw_cargo_age_scale();
    return 0;
}
switch (FEAT_TRAINS, SELF, sw_age_mid_second_tr2012, position_in_articulated_veh % 3) {
    1: return 200 * sw_cargo_age_scale();
    return 0;
}

