// SPDX-License-Identifier: GPL-2.0-only
// Copyright (C) 2026 Andy, Bob, Carl, Dennis, Eric, Frank
// ============================================================================
// China Fictional Maglev Set
// NML source, 2026-11-01 v2.1
//
// Liveries:
//   TR08   : A white/red, C Shanghai Maglev, G RZD red/white/grey
//   TR2012 : A white/red, B Shanghai Maglev, C orange/yellow,
//            D/Df JNR185 forward/reverse, E cream/vermilion,
//            F white/indigo, G white/company colour,
//            H Shanghai bus link
//   TR2015 : red dragon / silver sword, first/second class mid consist
//
// Purchase list (7 items):
//   tr08_head_first   Transrapid 08 head car, first class
//   tr08_head_second  Transrapid 08 head car, second class
//   tr2012_head       Transrapid 2012 head car, second class only
//   mid_first         first class intermediate car (TR08 + TR2015)
//   mid_second        second class intermediate car (TR08 + TR2012 + TR2015)
//   maglevranger_2015 MR2015 engineering car
//   tr2015_head       TR2015 passenger head car
//
// Every item is a 2 + 8 + 2 articulated unit = 12/16 tile = 0.75 tile.
// Only the middle articulated part carries a sprite. With two regular head
// cars, their global positions determine forward and reverse orientation.
//
// Livery is chosen by the head car's cargo_subtype.  Intermediate cars read
// the livery from PARENT (the leading head car), so the whole train always
// follows the head car's livery.
//
// IMPORTANT (see 2026-10-20 fix):
//   A livery_override block replaces the *whole* graphics block of the wagon.
//   Every callback the wagon needs (length, articulated_part, capacity, age,
//   power, ...) must therefore be repeated inside the override, otherwise the
//   wagon falls back to the plain Action 0 defaults (length = 8 per part =>
//   the unit becomes 24/16 = 1.5 tile, and the capacity callback is evaluated
//   with a broken part position => 0).  This is why `length` and
//   `articulated_part` are present in every livery_override below.
// ============================================================================

grf {
    grfid: "\4F\3F\01\00";
    name: string(STR_GRF_NAME);
    desc: string(STR_GRF_DESC);
    url: string(STR_GRF_URL);
    version: 1;
    min_compatible_version: 1;
    param 0 {
        param_capacity {
            type: int;
            name: string(STR_PARAM_CAPACITY);
            desc: string(STR_PARAM_CAPACITY_DESC);
            min_value: 25;
            max_value: 200;
            def_value: 100;
        }
    }
    param 1 {
        param_purchase {
            type: int;
            name: string(STR_PARAM_PURCHASE);
            desc: string(STR_PARAM_PURCHASE_DESC);
            min_value: 25;
            max_value: 300;
            def_value: 100;
        }
    }
    param 2 {
        param_running {
            type: int;
            name: string(STR_PARAM_RUNNING);
            desc: string(STR_PARAM_RUNNING_DESC);
            min_value: 25;
            max_value: 300;
            def_value: 100;
        }
    }
    param 3 {
        param_mail_capacity_mode {
            type: int;
            name: string(STR_PARAM_MAIL_CAPACITY);
            desc: string(STR_PARAM_MAIL_CAPACITY_DESC);
            min_value: 0;
            max_value: 3;
            def_value: 1;
            names: {
                0: string(STR_PARAM_MAIL_X05);
                1: string(STR_PARAM_MAIL_X1);
                2: string(STR_PARAM_MAIL_X2);
                3: string(STR_PARAM_MAIL_X4);
            };
        }
    }
    param 4 {
        param_loading_mode {
            type: int;
            name: string(STR_PARAM_LOADING_RATE);
            desc: string(STR_PARAM_LOADING_RATE_DESC);
            min_value: 0;
            max_value: 2;
            def_value: 0;
            names: {
                0: string(STR_PARAM_X1);
                1: string(STR_PARAM_X2);
                2: string(STR_PARAM_X4);
            };
        }
    }
    param 5 {
        param_cargo_age_mode {
            type: int;
            name: string(STR_PARAM_CARGO_AGE);
            desc: string(STR_PARAM_CARGO_AGE_DESC);
            min_value: 0;
            max_value: 2;
            def_value: 0;
            names: {
                0: string(STR_PARAM_X1);
                1: string(STR_PARAM_X2);
                2: string(STR_PARAM_X4);
            };
        }
    }
}

cargotable {
    PASS,
    MAIL,
    GOOD,
    VALU,
    GOLD,
    DIAM,
    FISH,
    FOOD,
    FRUT,
    FRVG,
    MILK,
    SGBT
}

// ----------------------------------------------------------------------------
// Sprite templates
// ----------------------------------------------------------------------------
template tpl_vehicle(fname) {
    [  0, 0,  36, 160, -14, -80, fname]
    [ 44, 0, 120, 116, -75, -72, fname]
    [172, 0, 192,  80, -96, -62, fname]
    [372, 0, 120, 116, -41, -72, fname]
    [500, 0,  36, 160, -14, -80, fname]
    [544, 0, 120, 116, -75, -72, fname]
    [672, 0, 192,  80, -96, -62, fname]
    [872, 0, 120, 116, -41, -72, fname]
}

// Tail car: swap row 1<->5, 2<->6, 3<->7, 4<->8
template tpl_vehicle_flip(fname) {
    [500, 0,  36, 160, -14, -80, fname]
    [544, 0, 120, 116, -75, -72, fname]
    [672, 0, 192,  80, -96, -62, fname]
    [872, 0, 120, 116, -41, -72, fname]
    [  0, 0,  36, 160, -14, -80, fname]
    [ 44, 0, 120, 116, -75, -72, fname]
    [172, 0, 192,  80, -96, -62, fname]
    [372, 0, 120, 116, -41, -72, fname]
}

template tpl_purchase(fname) {
    [672, 0, 192, 80, -96, -62, fname]
}

// Same 3/4 view as tpl_purchase, but taken from the opposite side.  Used for
// liveries whose "flip" voxel model was made by rotating the whole car.
template tpl_purchase_flip(fname) {
    [172, 0, 192, 80, -96, -62, fname]
}

spriteset (empty_sprites, "gfx/empty.png") {
    [0, 0, 2, 2, 0, 0, CROP]
}

