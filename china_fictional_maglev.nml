    5: sp_head_t12_E;
    6: sp_head_t12_F;
    7: sp_head_t12_G;
    8: sp_head_t12_H;
    sp_head_t12_A;
}

switch (FEAT_TRAINS, SELF, sw_tr2012_head_tail_graphics, cargo_subtype) {
