// TR2012 JNR185 green diagonal.
//
// The Df voxel model was made by rotating the whole car 180 degrees with the
// paint pattern fixed in world space, so its rendered sheet already has the
// body turned around (Df view d == D view d+4 for the body) while the paint
// stays in the same world orientation (Df view d has the same stripe slope as
// D view d).  Consequently:
//   "looks like a head"  = tpl_vehicle_flip(Df sheet)
//   "looks like a tail"  = tpl_vehicle(Df sheet)
// which is the opposite of a paint-only variant such as TR08 H/Hf.
//
// Forward refit: head = D head,  tail = Df tail
// Reverse refit: head = Df head, tail = D tail
// This keeps the diagonal continuous over the whole train without any extra
// per-vehicle refit for the rear cab.
spriteset (sp_t12_D_head, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP) {
    tpl_vehicle("gfx/game_4x/TR2012_head_D_jnr185_green_diagonal_32bpp.png")
}
spriteset (sp_t12_D_tail, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP) {
    tpl_vehicle_flip("gfx/game_4x/TR2012_head_D_jnr185_green_diagonal_32bpp.png")
}
spriteset (sp_purchase_head_t12_D, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP) {
    tpl_purchase("gfx/game_4x/TR2012_head_D_jnr185_green_diagonal_32bpp.png")
}

spriteset (sp_t12_Df_head, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP) {
    tpl_vehicle_flip("gfx/game_4x/TR2012_head_D_jnr185_green_diagonal_flip_32bpp.png")
}
spriteset (sp_t12_Df_tail, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP) {
    tpl_vehicle("gfx/game_4x/TR2012_head_D_jnr185_green_diagonal_flip_32bpp.png")
}
spriteset (sp_purchase_head_t12_Df, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP) {
    tpl_purchase_flip("gfx/game_4x/TR2012_head_D_jnr185_green_diagonal_flip_32bpp.png")
}

