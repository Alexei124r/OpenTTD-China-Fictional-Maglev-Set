    2: sp_purchase_head_t12_C;
    3: sp_purchase_head_t12_D;
    4: sp_purchase_head_t12_Df;
    5: sp_purchase_head_t12_E;
    6: sp_purchase_head_t12_F;
    7: sp_purchase_head_t12_G;
    8: sp_purchase_head_t12_H;
    sp_purchase_head_t12_A;
}

switch (FEAT_TRAINS, SELF, sw_tr2012_head_subtype_text, cargo_subtype) {
    0: return string(STR_SUB_T12_A_S);
    1: return string(STR_SUB_T12_B_S);
    2: return string(STR_SUB_T12_C_S);
    3: return string(STR_SUB_T12_D_S);
    4: return string(STR_SUB_T12_Df_S);
    5: return string(STR_SUB_T12_E_S);
    6: return string(STR_SUB_T12_F_S);
    7: return string(STR_SUB_T12_G_S);
    8: return string(STR_SUB_T12_H_S);
    return string(STR_SUB_T12_A_S);
}

// TR2012 uses the same two-head position comparison as TR08.
switch (FEAT_TRAINS, SELF, sw_tr2012_head_direction, sw_head_is_front()) {
    1: sw_tr2012_head_livery_graphics;
    sw_tr2012_head_tail_graphics;
}

switch (FEAT_TRAINS, SELF, sw_tr2012_head_graphics,
    position_in_articulated_veh % 3) {
    1: sw_tr2012_head_direction;
    empty_sprites;
}

switch (FEAT_TRAINS, SELF, sw_tr2012_head_articulated, extra_callback_info1) {
    1..2: return tr2012_head;
    return CB_RESULT_NO_MORE_ARTICULATED_PARTS;
}

// ----------------------------------------------------------------------------
// Intermediate car graphics
// ----------------------------------------------------------------------------
// Standalone (not attached to a head car): TR08 white/red, no capacity,
// no power, no speed.  The item is meant to be used inside a train only.
switch (FEAT_TRAINS, SELF, sw_mid_standalone, position_in_articulated_veh % 3) {
    1: sp_mid_tr08_A;
    empty_sprites;
}

// The livery always follows the leading head car (PARENT scope reads the
// cargo_subtype of the front vehicle of the consist).
switch (FEAT_TRAINS, PARENT, sw_parent_tr08_mid_livery, cargo_subtype) {
    0: sp_mid_tr08_A;
    1: sp_mid_tr08_C;
    2: sp_mid_tr08_G;
    sp_mid_tr08_A;
}

switch (FEAT_TRAINS, PARENT, sw_parent_tr2012_mid_livery, cargo_subtype) {
    0: sp_mid_t12_A;
    1: sp_mid_t12_B;
    2: sp_mid_t12_C;
    3: sp_mid_t12_D;
    4: sp_mid_t12_Dr;
    5: sp_mid_t12_E;
    6: sp_mid_t12_F;
    7: sp_mid_t12_G;
    8: sp_mid_t12_H;
    sp_mid_t12_A;
}

switch (FEAT_TRAINS, SELF, sw_ov_tr08_mid_graphics, position_in_articulated_veh % 3) {
    1: sw_parent_tr08_mid_livery;
    empty_sprites;
}

switch (FEAT_TRAINS, SELF, sw_ov_tr2012_mid_graphics, position_in_articulated_veh % 3) {
    1: sw_parent_tr2012_mid_livery;
    empty_sprites;
}

switch (FEAT_TRAINS, SELF, sw_mid_first_articulated, extra_callback_info1) {
    1..2: return mid_first;
    return CB_RESULT_NO_MORE_ARTICULATED_PARTS;
}

switch (FEAT_TRAINS, SELF, sw_mid_second_articulated, extra_callback_info1) {
    1..2: return mid_second;
    return CB_RESULT_NO_MORE_ARTICULATED_PARTS;
}

// ----------------------------------------------------------------------------
// Attach rules
// ----------------------------------------------------------------------------
// In can_attach_wagon, PARENT is the existing train before the candidate
// wagon. This is the reliable scope for counting already-coupled MR2015s.
switch (FEAT_TRAINS, PARENT, sw_parent_is_mr2015, vehicle_type_id) {
    maglevranger_2015: return 1;
    return 0;
}

// The first MR2015 in a mixed consist must itself be at an outer end.
switch (FEAT_TRAINS, SELF, sw_mr2015_attach_first,
    (position_in_consist < 3) || (position_in_consist_from_end < 3)) {
    1: return CB_RESULT_ATTACH_ALLOW;
    return CB_RESULT_ATTACH_DISALLOW;
}

// If the existing MR2015 is at the front, the second one goes at the rear.
switch (FEAT_TRAINS, SELF, sw_mr2015_attach_second_rear,
    position_in_consist_from_end < 3) {
    1: return CB_RESULT_ATTACH_ALLOW;
    return CB_RESULT_ATTACH_DISALLOW;
}

// Conversely, an existing rear MR2015 allows the second one at the front.
switch (FEAT_TRAINS, SELF, sw_mr2015_attach_second_front,
    position_in_consist < 3) {
    1: return CB_RESULT_ATTACH_ALLOW;
    return CB_RESULT_ATTACH_DISALLOW;
}

switch (FEAT_TRAINS, SELF, sw_mr2015_attach_second,
    sw_parent_is_mr2015()) {
    1: sw_mr2015_attach_second_rear;
    sw_mr2015_attach_second_front;
}

// Existing MR2015s are represented by three physical parts per unit.
// 0 = first unit, 3 = one existing unit, 6 = two existing units.
switch (FEAT_TRAINS, SELF, sw_mr2015_attach_mixed,
    sw_parent_mr2015_parts()) {
    0: sw_mr2015_attach_first;
    3: sw_mr2015_attach_second;
    return CB_RESULT_ATTACH_DISALLOW;
}

switch (FEAT_TRAINS, SELF, sw_mr2015_attach_allowed,
    sw_parent_has_regular_vehicle()) {
    1: sw_mr2015_attach_mixed;
    return CB_RESULT_ATTACH_ALLOW;
}

// Do not permit the first regular vehicle to turn a pure MR2015 consist of
// more than two units into an invalid mixed consist.
switch (FEAT_TRAINS, SELF, sw_regular_attach_allowed,
    sw_parent_mr2015_parts()) {
    0..6: return CB_RESULT_ATTACH_ALLOW;
    return CB_RESULT_ATTACH_DISALLOW;
}

switch (FEAT_TRAINS, SELF, sw_regular_head_attach_allowed,
    sw_parent_regular_head_parts()) {
    0: sw_regular_attach_allowed;
    3: sw_regular_attach_allowed;
    return CB_RESULT_ATTACH_DISALLOW;
}

switch (FEAT_TRAINS, SELF, sw_tr08_can_attach, vehicle_type_id) {
    tr08_head_first: sw_regular_head_attach_allowed;
    tr08_head_second: sw_regular_head_attach_allowed;
    tr2012_head: sw_regular_head_attach_allowed;
    mid_first: sw_regular_attach_allowed;
    mid_second: sw_regular_attach_allowed;
    maglevranger_2015: sw_mr2015_attach_allowed;
    return CB_RESULT_ATTACH_DISALLOW;
}

switch (FEAT_TRAINS, SELF, sw_tr2012_can_attach, vehicle_type_id) {
    tr08_head_first: sw_regular_head_attach_allowed;
    tr08_head_second: sw_regular_head_attach_allowed;
    tr2012_head: sw_regular_head_attach_allowed;
    mid_second: sw_regular_attach_allowed;
    maglevranger_2015: sw_mr2015_attach_allowed;
    return CB_RESULT_ATTACH_DISALLOW;
}

switch (FEAT_TRAINS, SELF, sw_mr2015_can_attach, vehicle_type_id) {
    tr08_head_first: sw_regular_head_attach_allowed;
    tr08_head_second: sw_regular_head_attach_allowed;
    tr2012_head: sw_regular_head_attach_allowed;
    mid_first: sw_regular_attach_allowed;
    mid_second: sw_regular_attach_allowed;
    tr2015_head: sw_regular_head_attach_allowed;
    tr2015_freight_head: sw_regular_head_attach_allowed;
    tr2015_freight_mid: sw_regular_attach_allowed;
    tr2015_refrigerated: sw_regular_attach_allowed;
    tr2015_zexl: sw_regular_attach_allowed;
    maglevranger_2015: sw_mr2015_attach_allowed;
    return CB_RESULT_ATTACH_DISALLOW;
}

switch (FEAT_TRAINS, SELF, sw_tr2015_can_attach, vehicle_type_id) {
    tr2015_head: sw_regular_head_attach_allowed;
    maglevranger_2015: sw_mr2015_attach_allowed;
    mid_first: sw_regular_attach_allowed;
    mid_second: sw_regular_attach_allowed;
    tr2015_zexl: sw_regular_attach_allowed;
    // Reserved for a future dining-car item ID.
    return CB_RESULT_ATTACH_DISALLOW;
}

switch (FEAT_TRAINS, SELF, sw_tr2015_freight_can_attach, vehicle_type_id) {
    tr2015_freight_head: sw_regular_head_attach_allowed;
    tr2015_freight_mid: sw_regular_attach_allowed;
    tr2015_refrigerated: sw_regular_attach_allowed;
    maglevranger_2015: sw_mr2015_attach_allowed;
    return CB_RESULT_ATTACH_DISALLOW;
}

// ----------------------------------------------------------------------------
// TR08 head car, first class
// ----------------------------------------------------------------------------
item (FEAT_TRAINS, tr08_head_first, 100) {
    property {
        name: string(STR_NAME_TR08_HEAD_FIRST);
        sprite_id: SPRITE_ID_NEW_TRAIN;
        misc_flags: bitmask(TRAIN_FLAG_MU);
        engine_class: ENGINE_CLASS_MAGLEV;
        climates_available: ALL_CLIMATES;
        introduction_date: date(1999,6,1);
        model_life: VEHICLE_NEVER_EXPIRES;
        vehicle_life: 30;
        track_type: MGLV;
        refittable_cargo_classes: bitmask(CC_PASSENGERS);
        non_refittable_cargo_classes: 0;
        cargo_allow_refit: [PASS];
        cargo_disallow_refit: [];
        refit_cost: 0;
        default_cargo_type: PASS;
        ai_special_flag: AI_FLAG_PASSENGER;
        // Must be non-zero: OpenTTD's Engine::CanCarryCargo() returns false
        // when the Action 0 capacity property is 0, and then the capacity
        // callback is never evaluated.  The real value comes from the
        // cargo_capacity callback below.
        cargo_capacity: 1;
        loading_speed: ((16 * param_capacity) / 100) * (1 << param_loading_mode);
        cargo_age_period: 400 * (1 << param_cargo_age_mode);
        speed: 430 km/h;
        power: 3600 kW;
        weight: 52 ton;
        tractive_effort_coefficient: 0.35;
        cost_factor: (130 * param_purchase) / 100;
        running_cost_base: RUNNING_COST_ELECTRIC;
        running_cost_factor: (100 * param_running) / 100;
        reliability_decay: 5;
    }
    graphics {
        additional_text: string(STR_DESC_TR08);
        can_attach_wagon: sw_tr08_can_attach;
        start_stop: sw_std_head_start_stop;
        cargo_subtype_text: sw_tr08_head_subtype_text;
        default: sw_tr08_head_graphics;
        purchase: sw_tr08_head_purchase;
        articulated_part: sw_tr08_head_articulated;
        length: sw_length_2_8_2;
        cargo_capacity: sw_cap_tr08_head_first;
        cargo_age_period: sw_age_tr08_head_first;
        power: sw_power_head_tr08;
        tractive_effort_coefficient: sw_traction_head_tr08;
        // Purchase menu shows value * number of articulated parts, so divide
        // by 3 to display the real 60 seats.
        purchase_cargo_capacity: (60 * param_capacity) / 300;
    }
    livery_override(mid_first) {
        default: sw_ov_tr08_mid_graphics;
        length: sw_length_2_8_2;
        articulated_part: sw_mid_first_articulated;
        cargo_capacity: sw_cap_mid_first;
        cargo_age_period: sw_age_mid_first;
        loading_speed: ((24 * param_capacity) / 100) * (1 << param_loading_mode);
        power: sw_power_mid_tr08;
        weight: 48;
        tractive_effort_coefficient: sw_traction_mid_tr08;
        cost_factor: (85 * param_purchase) / 100;
        running_cost_factor: (65 * param_running) / 100;
    }
    livery_override(mid_second) {
        default: sw_ov_tr08_mid_graphics;
        length: sw_length_2_8_2;
        articulated_part: sw_mid_second_articulated;
        cargo_capacity: sw_cap_mid_second_tr08;
        cargo_age_period: sw_age_mid_second_tr08;
        loading_speed: ((30 * param_capacity) / 100) * (1 << param_loading_mode);
        power: sw_power_mid_tr08;
        weight: 48;
        tractive_effort_coefficient: sw_traction_mid_tr08;
        cost_factor: (85 * param_purchase) / 100;
        running_cost_factor: (65 * param_running) / 100;
    }
}

