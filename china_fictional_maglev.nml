switch (FEAT_TRAINS, SELF, sw_tr08_head_subtype_text, cargo_subtype) {
    0: return string(STR_SUB_TR08_A_F);
    1: return string(STR_SUB_TR08_C_F);
    2: return string(STR_SUB_TR08_G_F);
    return string(STR_SUB_TR08_A_F);
}

switch (FEAT_TRAINS, SELF, sw_tr08_head_subtype_text_second, cargo_subtype) {
    0: return string(STR_SUB_TR08_A_S);
    1: return string(STR_SUB_TR08_C_S);
    2: return string(STR_SUB_TR08_G_S);
    return string(STR_SUB_TR08_A_S);
}

switch (FEAT_TRAINS, SELF, sw_tr08_head_livery_graphics, cargo_subtype) {
    0: sp_head_tr08_A;
    1: sp_head_tr08_C;
    2: sp_head_tr08_G;
    sp_head_tr08_A;
}

switch (FEAT_TRAINS, SELF, sw_tr08_head_tail_graphics, cargo_subtype) {
    0: sp_head_tr08_tail_A;
    1: sp_head_tr08_tail_C;
    2: sp_head_tr08_tail_G;
    sp_head_tr08_tail_A;
}

switch (FEAT_TRAINS, SELF, sw_tr08_head_purchase, cargo_subtype) {
    0: sp_purchase_head_tr08_A;
    1: sp_purchase_head_tr08_C;
    2: sp_purchase_head_tr08_G;
    sp_purchase_head_tr08_A;
}

// Single-head trains stay forward. For two heads, compare their positions
// from both ends; engineering cars outside the train do not matter.
switch (FEAT_TRAINS, SELF, sw_tr08_head_direction, sw_head_is_front()) {
    1: sw_tr08_head_livery_graphics;
    sw_tr08_head_tail_graphics;
}

switch (FEAT_TRAINS, SELF, sw_tr08_head_graphics,
    position_in_articulated_veh % 3) {
    1: sw_tr08_head_direction;
    empty_sprites;
}

switch (FEAT_TRAINS, SELF, sw_tr08_head_articulated, extra_callback_info1) {
    1..2: return tr08_head_first;
    return CB_RESULT_NO_MORE_ARTICULATED_PARTS;
}

switch (FEAT_TRAINS, SELF, sw_tr08_head_second_articulated, extra_callback_info1) {
    1..2: return tr08_head_second;
    return CB_RESULT_NO_MORE_ARTICULATED_PARTS;
}

