    2: sp_head_t12_tail_C;
    3: sp_t12_Df_tail;
    4: sp_t12_D_tail;
    5: sp_head_t12_tail_E;
    6: sp_head_t12_tail_F;
    7: sp_head_t12_tail_G;
    8: sp_head_t12_tail_H;
    sp_head_t12_tail_A;
}

switch (FEAT_TRAINS, SELF, sw_tr2012_head_purchase, cargo_subtype) {
    0: sp_purchase_head_t12_A;
